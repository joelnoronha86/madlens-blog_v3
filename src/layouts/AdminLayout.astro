---
import '../styles/global.css';
import { AdminClerkProvider } from '../components/admin/ClerkProvider.tsx';
import { Navbar } from '../components/Navbar.tsx';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{Astro.props.title ?? 'Admin'} — Geographies Admin</title>
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-surface text-text">
    <AdminClerkProvider>
      <Navbar />
      <div class="flex flex-grow overflow-hidden">
        <aside class="hidden md:flex md:w-64 flex-col border-r border-border bg-surface/50">
          <nav class="p-6 space-y-1">
            <a
              href="/admin"
              class="flex items-center gap-3 px-3 py-2 rounded-lg bg-accent text-surface font-medium"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              Dashboard
            </a>
            <a
              href="/admin/new"
              class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-accent/50 hover:text-accent transition-colors font-medium"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
              New Post
            </a>
            <a
              href="/admin/gallery"
              class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-accent/50 hover:text-accent transition-colors font-medium"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              Gallery
            </a>
            <a
              href="/admin/settings"
              class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-accent/50 hover:text-accent transition-colors font-medium"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37M9 10.8a1 1 0 00-1 1v2a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 00-1-1H9z" />
              </svg>
              Settings
            </a>
          </nav>
        </aside>
        <main class="flex-grow overflow-y-auto p-6 md:p-8">
          <slot />
        </main>
      </div>
    </AdminClerkProvider>
  </body>
</html>
