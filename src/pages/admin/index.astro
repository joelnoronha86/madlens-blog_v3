---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const draftPosts = posts.filter((p) => p.data.draft);
const publishedPosts = posts.filter((p) => !p.data.draft);
---

<AdminLayout title="Dashboard">
  <script>
    // Clerk auth state is handled by the provider; this page reads posts from Astro content collections
  </script>

  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-end mb-8 gap-4">
      <div>
        <h1 class="text-3xl font-heading font-bold text-text mb-2">Dashboard</h1>
        <p class="text-muted font-body">
          Manage your essays, drafts, and published posts.
        </p>
      </div>
      <a
        href="/admin/new"
        class="inline-flex items-center gap-2 px-6 py-3 bg-text text-surface rounded-lg font-medium hover:bg-accent transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
        New Post
      </a>
    </div>

    <div class="grid md:grid-cols-2 gap-6 mb-8">
      <div class="bg-surface border border-border rounded-lg p-6">
        <p class="text-sm text-muted font-tech mb-2">Published</p>
        <p class="text-3xl font-heading font-bold text-text">{publishedPosts.length}</p>
      </div>
      <div class="bg-surface border border-border rounded-lg p-6">
        <p class="text-sm text-muted font-tech mb-2">Drafts</p>
        <p class="text-3xl font-heading font-bold text-text">{draftPosts.length}</p>
      </div>
    </div>

    <section>
      <h2 class="text-2xl font-heading font-bold text-text mb-6">All Posts</h2>
      {posts.length === 0 ? (
        <p class="text-muted">No posts found. Create your first post to get started.</p>
      ) : (
        <div class="space-y-4">
          {posts.map((post) => (
            <article
              class={`flex items-center justify-between p-4 rounded-lg border border-border ${
                post.data.draft ? 'bg-amber-50/50 border-amber-100' : 'bg-surface'
              }`}
            >
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded bg-surface/50 flex items-center justify-center font-tech text-sm text-muted">
                  {post.data.title.charAt(0).toUpperCase()}
                </div>
                <div>
                  <h3 class="font-heading font-bold text-text">{post.data.title}</h3>
                  <p class="text-sm text-muted font-tech">
                    {post.data.tags.join(', ') || 'No tags'}
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <span
                  class={`px-2 py-1 rounded text-xs font-medium ${
                    post.data.draft
                      ? 'bg-amber-100 text-amber-800 border border-amber-200'
                      : 'bg-green-100 text-green-800 border border-green-200'
                  }`}
                >
                  {post.data.draft ? 'Draft' : 'Published'}
                </span>
                <a
                  href={`/admin/edit/${post.slug}`}
                  class="text-accent hover:text-accent-hover font-medium text-sm"
                >
                  Edit
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </section>
  </div>
</AdminLayout>
