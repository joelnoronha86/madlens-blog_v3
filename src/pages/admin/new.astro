---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { NewPostClient } from '../../components/admin/NewPostClient.tsx';
---

<AdminLayout title="New Post">
  <div class="max-w-4xl mx-auto">
    <div class="mb-8">
      <h1 class="text-3xl font-heading font-bold text-text mb-2">New Post</h1>
      <p class="text-muted font-body">
        Write your essay. Save as draft or publish to production.
      </p>
    </div>

    <NewPostClient client:load />
  </div>
</AdminLayout>
