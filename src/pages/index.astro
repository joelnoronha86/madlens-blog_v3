---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const publishedPosts = posts
  .filter((p) => !p.data.draft)
  .sort((a, b) => {
    const aDate = new Date(a.data.publishedAt ?? a.data._astro?.published ?? 0).getTime();
    const bDate = new Date(b.data.publishedAt ?? b.data._astro?.published ?? 0).getTime();
    return bDate - aDate;
  });
---

<BaseLayout title="Geographies of Textiles & Natural Dyes">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-16">
      <h1 class="text-5xl md:text-5xl font-heading text-text mb-4 leading-tight">
        Geographies of<br />
        Textiles &amp; Natural Dyes
      </h1>
      <p class="text-xl text-muted max-w-2xl mx-auto font-body">
        A researcher-artist's field notebook — where dye chemistry meets earth, plant, and
        place. Scientific essays, poetic observations, and images from natural dyeing
        processes across geographies.
      </p>
    </div>

    <section class="mb-16">
      <h2 class="text-2xl font-heading text-text mb-8">Recent Essays</h2>
      {publishedPosts.length === 0 ? (
        <p class="text-muted">No published essays yet.</p>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {publishedPosts.map((post) => (
            <article
              class="group border border-border rounded-lg p-6 hover:border-accent transition-colors"
            >
              {post.data.coverImage && (
                <img
                  src={post.data.coverImage}
                  alt={post.data.title}
                  class="w-full h-48 object-cover rounded mb-4 shadow-md"
                  loading="lazy"
                />
              )}
              <h3 class="text-xl font-heading text-text mb-2 group-hover:text-accent transition-colors">
                {post.data.title}
              </h3>
              <p class="text-muted font-body mb-4 line-clamp-3">{post.data.description}</p>
              <a
                href={`/posts/${post.slug}/`}
                class="inline-block font-tech text-sm text-accent hover:text-accent-hover font-medium"
              >
                Read essay →
              </a>
            </article>
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>
